  "responses": [
    {
      "id": "p01-kazoku",
      "respondentId": "p01",
      "wordId": "kazoku",
      "text": "深い絆",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 2,
        "column": 3
      }
    },
    {
      "id": "p01-ai",
      "respondentId": "p01",
      "wordId": "ai",
      "text": "執念、執着",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 2,
        "column": 4
      }
    },
    {
      "id": "p01-jiyuu",
      "respondentId": "p01",
      "wordId": "jiyuu",
      "text": "精神的に自立し、何にも縛られない。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 2,
        "column": 5
      }
    },
    {
      "id": "p02-kazoku",
      "respondentId": "p02",
      "wordId": "kazoku",
      "text": "人生で初めての恋",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 3,
        "column": 3
      }
    },
    {
      "id": "p02-ai",
      "respondentId": "p02",
      "wordId": "ai",
      "text": "柔らかい、触れない、でも感じられる",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 3,
        "column": 4
      }
    },
    {
      "id": "p02-jiyuu",
      "respondentId": "p02",
      "wordId": "jiyuu",
      "text": "自然の中遊ぶ",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 3,
        "column": 5
      }
    },
    {
      "id": "p03-kazoku",
      "respondentId": "p03",
      "wordId": "kazoku",
      "text": "困ったときに、遠慮せずに頼れる人たち",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 4,
        "column": 3
      }
    },
    {
      "id": "p03-ai",
      "respondentId": "p03",
      "wordId": "ai",
      "text": "他の人のために努力する気持ち",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 4,
        "column": 4
      }
    },
    {
      "id": "p03-jiyuu",
      "respondentId": "p03",
      "wordId": "jiyuu",
      "text": "行きたいところに行き、食べたいものを食べられる。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 4,
        "column": 5
      }
    },
    {
      "id": "p04-kazoku",
      "respondentId": "p04",
      "wordId": "kazoku",
      "text": "無条件で支持するとお互いに理解することができる",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 5,
        "column": 3
      }
    },
    {
      "id": "p04-ai",
      "respondentId": "p04",
      "wordId": "ai",
      "text": "配慮しないで、何を言っても大丈夫だ",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 5,
        "column": 4
      }
    },
    {
      "id": "p04-jiyuu",
      "respondentId": "p04",
      "wordId": "jiyuu",
      "text": "自分のやりたいことができて、それに責任を持つこと。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 5,
        "column": 5
      }
    },
    {
      "id": "p05-kazoku",
      "respondentId": "p05",
      "wordId": "kazoku",
      "text": "血縁があるみたい人",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 6,
        "column": 3
      }
    },
    {
      "id": "p05-ai",
      "respondentId": "p05",
      "wordId": "ai",
      "text": "わからない",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 6,
        "column": 4
      }
    },
    {
      "id": "p05-jiyuu",
      "respondentId": "p05",
      "wordId": "jiyuu",
      "text": "するでもしないでもどうでも欲しい物が得って、嫌い物が失う",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 6,
        "column": 5
      }
    },
    {
      "id": "p06-kazoku",
      "respondentId": "p06",
      "wordId": "kazoku",
      "text": "お互いに助け合い、支え合いながら生活する人たちのことです。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 7,
        "column": 3
      }
    },
    {
      "id": "p06-ai",
      "respondentId": "p06",
      "wordId": "ai",
      "text": "誰かを大切に思い、優しくしたり、支えたりする気持ち",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 7,
        "column": 4
      }
    },
    {
      "id": "p06-jiyuu",
      "respondentId": "p06",
      "wordId": "jiyuu",
      "text": "自分で考えて、自分の意思で決めたり、行動したりできること",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 7,
        "column": 5
      }
    },
    {
      "id": "p07-kazoku",
      "respondentId": "p07",
      "wordId": "kazoku",
      "text": "    血がつながっている人",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 8,
        "column": 3
      }
    },
    {
      "id": "p07-ai",
      "respondentId": "p07",
      "wordId": "ai",
      "text": "    好きになってから、長い時間がたっても、まだ好き",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 8,
        "column": 4
      }
    },
    {
      "id": "p07-jiyuu",
      "respondentId": "p07",
      "wordId": "jiyuu",
      "text": "言いたいことを言って、やりたいことをやる",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 8,
        "column": 5
      }
    },
    {
      "id": "p08-kazoku",
      "respondentId": "p08",
      "wordId": "kazoku",
      "text": "お金や愛情をなんほどでも送り会えるグループだ。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 9,
        "column": 3
      }
    },
    {
      "id": "p08-ai",
      "respondentId": "p08",
      "wordId": "ai",
      "text": "相手からまたは相手に温かい感情だ",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 9,
        "column": 4
      }
    },
    {
      "id": "p08-jiyuu",
      "respondentId": "p08",
      "wordId": "jiyuu",
      "text": "やりたくない事をやらない権力だ。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 9,
        "column": 5
      }
    },
    {
      "id": "p09-kazoku",
      "respondentId": "p09",
      "wordId": "kazoku",
      "text": "一緒に暮らしている親や子どもなどの血縁関係がある人",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 10,
        "column": 3
      }
    },
    {
      "id": "p09-ai",
      "respondentId": "p09",
      "wordId": "ai",
      "text": "大切にする気持ち、好きという気持ち",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 10,
        "column": 4
      }
    },
    {
      "id": "p09-jiyuu",
      "respondentId": "p09",
      "wordId": "jiyuu",
      "text": "縛らないで、好きなことができること。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 10,
        "column": 5
      }
    },
    {
      "id": "p10-kazoku",
      "respondentId": "p10",
      "wordId": "kazoku",
      "text": "一緒にご飯を食べて普通の日だと感じる人",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 11,
        "column": 3
      }
    },
    {
      "id": "p10-ai",
      "respondentId": "p10",
      "wordId": "ai",
      "text": "見返りを求めない貢献",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 11,
        "column": 4
      }
    },
    {
      "id": "p10-jiyuu",
      "respondentId": "p10",
      "wordId": "jiyuu",
      "text": "何々する時間を自分で決める",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 11,
        "column": 5
      }
    },
    {
      "id": "p11-kazoku",
      "respondentId": "p11",
      "wordId": "kazoku",
      "text": "家族は 私にとって一番 大切な 存在です。はなれていても いつも心の支えです。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 12,
        "column": 3
      }
    },
    {
      "id": "p11-ai",
      "respondentId": "p11",
      "wordId": "ai",
      "text": "愛とは 相手を思いやり 大切にすることです。言葉だけでなく 行動で 伝えることも大切です。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 12,
        "column": 4
      }
    },
    {
      "id": "p11-jiyuu",
      "respondentId": "p11",
      "wordId": "jiyuu",
      "text": "自由とは 自分で考え 自分の責任で行動することです。自由には 責任も必要です。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 12,
        "column": 5
      }
    },
    {
      "id": "p12-kazoku",
      "respondentId": "p12",
      "wordId": "kazoku",
      "text": "愛がない人にとって、血縁者だけ。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 13,
        "column": 3
      }
    },
    {
      "id": "p12-ai",
      "respondentId": "p12",
      "wordId": "ai",
      "text": "見返りを求めない。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 13,
        "column": 4
      }
    },
    {
      "id": "p12-jiyuu",
      "respondentId": "p12",
      "wordId": "jiyuu",
      "text": "ルールや法律などは違反じゃなくて、他の方に影響がない範囲で、何をしてもいい。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 13,
        "column": 5
      }
    },
    {
      "id": "p13-kazoku",
      "respondentId": "p13",
      "wordId": "kazoku",
      "text": "血縁関係のある人たちのこと",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 14,
        "column": 3
      }
    },
    {
      "id": "p13-ai",
      "respondentId": "p13",
      "wordId": "ai",
      "text": "恋人同士の間に生まれる感情",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 14,
        "column": 4
      }
    },
    {
      "id": "p13-jiyuu",
      "respondentId": "p13",
      "wordId": "jiyuu",
      "text": "いつでもしたいことをすることができること",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 14,
        "column": 5
      }
    },
    {
      "id": "p14-kazoku",
      "respondentId": "p14",
      "wordId": "kazoku",
      "text": "いつも自分をささえてくれる大切な人たちです。うれしいとき　も　かなしときいしょにいくれるそんざいです。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 15,
        "column": 3
      }
    },
    {
      "id": "p14-ai",
      "respondentId": "p14",
      "wordId": "ai",
      "text": "あいてをじぶんをおもいあいてのしあわせをねがうきちです。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 15,
        "column": 4
      }
    },
    {
      "id": "p14-jiyuu",
      "respondentId": "p14",
      "wordId": "jiyuu",
      "text": "自分で考えてじぶんのすきなことをえらぶこができることです。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 15,
        "column": 5
      }
    },
    {
      "id": "p15-kazoku",
      "respondentId": "p15",
      "wordId": "kazoku",
      "text": "幸せ、どこにお互いに支え合う人たちがいます",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 16,
        "column": 3
      }
    },
    {
      "id": "p15-ai",
      "respondentId": "p15",
      "wordId": "ai",
      "text": "人や物に対する感情的なつながり。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 16,
        "column": 4
      }
    },
    {
      "id": "p15-jiyuu",
      "respondentId": "p15",
      "wordId": "jiyuu",
      "text": "自分で考え、話し、行動すること。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 16,
        "column": 5
      }
    },
    {
      "id": "p16-kazoku",
      "respondentId": "p16",
      "wordId": "kazoku",
      "text": "家族とは、いつも自分のことを心配して、困ったときに助けてくれる大切な人たちです。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 17,
        "column": 3
      }
    },
    {
      "id": "p16-ai",
      "respondentId": "p16",
      "wordId": "ai",
      "text": "愛とは、相手の幸せを自分の幸せのように考え、大切にする気持ちだと思います。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 17,
        "column": 4
      }
    },
    {
      "id": "p16-jiyuu",
      "respondentId": "p16",
      "wordId": "jiyuu",
      "text": "自由とは、自分で考えて、自分の好きな道を選ぶことができることです。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 17,
        "column": 5
      }
    },
    {
      "id": "p17-kazoku",
      "respondentId": "p17",
      "wordId": "kazoku",
      "text": "血のつながりだけではなく、自分を大切にしてくれる人や、自分が大切に思う人、そして心から親しいと感じる人も、みんな家族だと思います。たとえば、友達は自分で選んだ家族です。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 18,
        "column": 3
      }
    },
    {
      "id": "p17-ai",
      "respondentId": "p17",
      "wordId": "ai",
      "text": "相手を理解し、尊重し、大切にすることだ。相手を自分のものにすることではなく、その人の幸せを心から願うことです。　愛には、家族への愛、友情、恋愛感情など、さまざまな形があり、自分自身を大切にすることも愛の一つです。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 18,
        "column": 4
      }
    },
    {
      "id": "p17-jiyuu",
      "respondentId": "p17",
      "wordId": "jiyuu",
      "text": "自分のできる範囲で、自分の良心や社会の道德に反しないことであれば、何でもする。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 18,
        "column": 5
      }
    },
    {
      "id": "p18-kazoku",
      "respondentId": "p18",
      "wordId": "kazoku",
      "text": "お互いに助け合い、支え合いながら生活する大切な存在です。",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 19,
        "column": 3
      }
    },
    {
      "id": "p18-ai",
      "respondentId": "p18",
      "wordId": "ai",
      "text": "家族以外の人に対する無条件の愛",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 19,
        "column": 4
      }
    },
    {
      "id": "p18-jiyuu",
      "respondentId": "p18",
      "wordId": "jiyuu",
      "text": "自由とは、自分の考えで物事を決め、自分らしく生きることができることです",
      "source": {
        "sheet": "フォームの回答 1",
        "row": 19,
        "column": 5
      }
    }
  ],
  "editorial": {
    "notice": "回答をもとに編者がまとめた定義",
    "method": "各回答に主分類を一つ付け、必要に応じて補助タグを付けています。分類は編者による解釈であり、回答者自身の選択やクラス全員の合意を示すものではありません。",
    "words": [
      {
        "id": "kazoku",
        "title": "家族",
        "reading": "かぞく",
